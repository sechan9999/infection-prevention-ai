        "organism_normalized": "Coagulase-negative staphylococci",
        "organism_is_contaminant": true,
        "set_count": 2,
        "separate_occasions": false,
        "both_sets_same_organism": true,
        "draw_site": "single venipuncture, 2 bottles",
        "cvc_insert_day": -7,
        "cvc_remove_day": null,
        "cvc_present_on_event_day": true,
        "patient_age_years": 68,
        "fever_38_plus": true,
        "secondary_bsi_primary_site": null,
        "prior_event_within_rit": false,
        "neutropenic": false
      },
      "expected": {
        "verdict": "non_candidate",
        "grade": null,
        "flags": ["not_separate_occasions"],
        "reason_contains": ["separate occasion"]
      },
      "definition_note": "The mapping bug this fixture exists to catch."
    }
